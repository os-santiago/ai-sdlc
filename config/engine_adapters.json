{
  "scc": {
    "binary": "scc",
    "probe": [
      "scc",
      "--version"
    ],
    "capabilities": {
      "supportsWorkspaceTrust": false,
      "modelConfigurable": true,
      "projectIdRequired": true
    },
    "argvBuilder": {
      "command": "chat",
      "substitution": {
        "mode": "argv-element",
        "shell": "never",
        "note": "Each {name} token occupies a whole argv element and MUST be replaced atomically with the validated value as one element (no re-splitting, no globbing, no shell joining). Unknown placeholders must be rejected, not substituted.",
        "placeholders": {
          "model": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$",
            "required": true
          },
          "prompt": {
            "pattern": "^[^\\u0000]{1,65536}$",
            "required": true
          },
          "manifestFile": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$",
            "required": true
          }
        }
      },
      "args": [
        "--model",
        "{model}",
        "--prompt",
        "{prompt}",
        "--manifest",
        "{manifestFile}",
        "--format",
        "json"
      ]
    },
    "configRenderer": {
      "format": "json",
      "path": "{manifestFile}"
    },
    "exitCodeMap": {
      "0": "Success",
      "10": "ValidationError",
      "20": "AgentError",
      "21": "AgentFailedError",
      "22": "MaxStepsExceeded",
      "23": "MaxRepairsExceeded",
      "24": "TimeoutError",
      "default": "AgentError"
    },
    "manifestMap": {
      "path": "{manifestFile}",
      "format": "json"
    }
  },
