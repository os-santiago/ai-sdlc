{
  "version": "ai-sdlc.project/v1",
  "repository": "os-santiago/ai-sdlc-sample-python",
  "baseBranch": "main",
  "verification": {
    "image": "docker.io/library/python@sha256:191083cdf6c7bda8c76158983163ead5d5cf7b77cf3033e805bb0f5296f51b4b",
    "command": ["python3", "-I", "-B", "-m", "unittest", "discover", "-s", ".", "-t", ".", "-p", "test_*.py"],
    "timeoutSeconds": 120,
    "cpu": "500m",
    "memory": "512Mi",
    "ephemeralStorage": "1Gi",
    "network": "none",
    "result": {"exitCode": true},
    "repeat": 2,
    "testGlobs": ["**/test_*.py"],
    "harnessGlobs": ["pyproject.toml", "setup.cfg", "setup.py", "**/conftest.py", "**/testdata/**"]
  },
  "publication": {
    "allow": ["**/*.py", "README.md"],
    "deny": ["*.py"],
    "maxChangedFiles": 6,
    "maxChangedBytes": 65536,
    "maxFileBytes": 32768
  },
  "merge": {
    "rulesetID": 1,
    "required": [{"context": "test", "appID": 15368}],
    "strictChecks": true,
    "resolveThreads": true,
    "humanApprovals": 0
  }
}
