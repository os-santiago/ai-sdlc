FROM docker.io/library/golang@sha256:ea30e25680a5470bac02b08bb0e0a735fb75bd0ab7d431b9b95ee0abef362586 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY internal ./internal
COPY components/verifier ./components/verifier
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/component ./components/verifier/cmd
FROM gcr.io/distroless/static:nonroot@sha256:8ce6dd87e9823c5b48dcfb2c8604714ccb351ce59607327bcc4957448da279b5
COPY --from=build /out/component /component
USER 1000:1000
EXPOSE 8087
ENTRYPOINT ["/component"]
