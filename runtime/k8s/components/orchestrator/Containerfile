# Build context: runtime/k8s/ (not the repo root)
#   podman build -f components/orchestrator/Containerfile -t ai-sdlc-orchestrator:dev .
FROM docker.io/library/golang@sha256:5f1b98fa02fe396ebce2a0227a0e08309e11792915b9dd2e1f71053d7e7e6666 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY internal ./internal
COPY components/orchestrator ./components/orchestrator
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/component ./components/orchestrator/cmd

FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
COPY --from=build /out/component /component
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/component"]
