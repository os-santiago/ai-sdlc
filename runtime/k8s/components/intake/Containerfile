FROM docker.io/library/golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY internal ./internal
COPY components/intake ./components/intake
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/component ./components/intake/cmd
FROM gcr.io/distroless/static:nonroot
COPY --from=build /out/component /component
USER 1000:1000
EXPOSE 8086
ENTRYPOINT ["/component"]
