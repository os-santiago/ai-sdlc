FROM docker.io/library/golang@sha256:205c7636d74e0ffbe3d007162df7d74f859f5a8c8322dfb9f907977686c126cf AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY internal ./internal
COPY components/build-controller ./components/build-controller
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/component ./components/build-controller/cmd

FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
COPY --from=build /out/component /component
USER 1000:1000
ENTRYPOINT ["/component"]
