FROM docker.io/library/golang@sha256:78c9e40f10516d7070156948a1747347cc5093022f06deeff3c9decd5faa3af7 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY internal ./internal
COPY components/artifact-builder ./components/artifact-builder
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/component ./components/artifact-builder/cmd
FROM gcr.io/distroless/static@sha256:816dc4d589459a7fe33b8a2e69edb70da56ffad7161f4b415937fa2bfe7e92e8
COPY --from=build /out/component /component
USER 1000:1000
ENTRYPOINT ["/component"]
