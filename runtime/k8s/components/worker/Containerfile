# Build context: runtime/k8s/ (not the repo root)
#   podman build -f components/worker/Containerfile -t ai-sdlc-worker:dev .
FROM docker.io/library/golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY internal ./internal
COPY components/worker ./components/worker
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/component ./components/worker/cmd

# worker is the one component that is not distroless: internal/engine.
# SCCEngine shells out to sc-agent-cli (`scc`), a Node CLI, and
# internal/checkout.GitCheckout shells out to `git`. Both are genuinely
# needed at runtime by this container alone — the other four components
# (admission-controller, orchestrator, release-manager, relay) stay
# distroless/static.
#
# sc-agent-cli is not published on npm (docs/runtime.md "Engine
# contract") — every runtime that invokes it builds it from the upstream
# repo's default branch. This mirrors
# .github/workflows/ai-sdlc-implement.yml's "Build scc engine from
# source" step (git clone --depth 1 && npm ci && npm run build), but
# cannot reuse that step's `npm link`/`npm install -g .`: both resolve a
# local directory to a *symlink* into node_modules rather than copying
# it (confirmed by building this image: the resulting
# /usr/local/lib/node_modules/sc-agent-cli was a dangling symlink back
# into this build stage's /opt/scc, which does not exist in the final
# stage). Pruning dev dependencies and copying /opt/scc wholesale avoids
# that; the final stage's wrapper script replaces the one dropped by
# not using npm's own global-install bin-linking.
FROM docker.io/library/node:22-alpine AS sccbuild
RUN apk add --no-cache git
RUN git clone --depth 1 https://github.com/os-santiago/sc-agent-cli /opt/scc \
    && cd /opt/scc && npm ci && npm run build && npm prune --omit=dev

# node:alpine (not distroless): running `scc` needs a Node runtime, and
# the base image's apk gives us a non-root `node` user plus `git`
# (internal/checkout's dependency) without hand-rolling either. OpenShift's
# restricted SCC still applies cleanly: no root-owned writes are needed
# anywhere this image reads from, and the pod sets runAsNonRoot/
# allowPrivilegeEscalation:false/capabilities:drop:[ALL] exactly like the
# distroless components (see deploy/kustomize/base/README.md "Security
# posture"). HOME and TMPDIR are both set under /workspaces (the same
# emptyDir volume AI_SDLC_WORKSPACE_DIR lives on) so SCCConfig's
# $HOME/.sc-agent/config.json write, npm/node's own cache writes, and
# SCCEngine.Invoke's os.MkdirTemp("", "ai-sdlc-attempt-*") call (which
# defaults to /tmp — part of the read-only root filesystem, confirmed by
# running a real dispatch against this image and hitting "mkdir
# /tmp/ai-sdlc-attempt-...: read-only file system") all have somewhere
# to go despite readOnlyRootFilesystem: true — no extra volume needed.
FROM docker.io/library/node:22-alpine
RUN apk add --no-cache git
COPY --from=sccbuild /opt/scc /opt/scc
# Replaces sc-agent-cli's own bin/scc wrapper (`import '../dist/cli.js'`,
# a relative import that would need to resolve correctly through
# whatever /usr/local/bin/scc ends up being — a symlink or not) with an
# equivalent wrapper using an absolute path, so where this file lives on
# PATH never matters.
RUN printf '#!/usr/bin/env node\nimport "/opt/scc/dist/cli.js";\n' > /usr/local/bin/scc \
    && chmod +x /usr/local/bin/scc
COPY --from=build /out/component /component
ENV HOME=/workspaces/home
ENV TMPDIR=/workspaces/tmp
USER node
EXPOSE 8080
ENTRYPOINT ["/component"]
