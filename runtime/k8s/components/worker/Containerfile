# Build context: runtime/k8s/ (not the repo root)
#   podman build -f components/worker/Containerfile -t ai-sdlc-worker:dev .
FROM docker.io/library/golang@sha256:ea30e25680a5470bac02b08bb0e0a735fb75bd0ab7d431b9b95ee0abef362586 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY internal ./internal
COPY components/worker ./components/worker
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/component ./components/worker/cmd \
    && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/executor ./components/worker/executor-cmd

# worker is the one component that is not distroless: internal/engine.
# SCCEngine shells out to sc-agent-cli (`scc`), a Node CLI, and
# internal/checkout.GitCheckout shells out to `git`. Both are genuinely
# needed at runtime by this container alone — the other four components
# (admission-controller, orchestrator, release-manager, relay) stay
# distroless/static.
#
# sc-agent-cli is not published on npm, so the worker builds it from its
# upstream repository. It cannot use `npm link`/
# `npm install -g .`: both resolve a local directory to a *symlink* into
# node_modules rather than copying it (confirmed by building this image:
# the resulting /usr/local/lib/node_modules/sc-agent-cli was a dangling
# symlink back into this build stage's /opt/scc, which does not exist in
# the final stage). Pruning dev dependencies and copying /opt/scc
# wholesale avoids that; the final stage's wrapper script replaces the
# one dropped by not using npm's own global-install bin-linking.
FROM docker.io/library/node:22-alpine AS sccbuild
RUN apk add --no-cache git
# Engine source pin (issue #356): immutable ref — full commit SHA or
# semver tag — baked into the image. The reviewed default is SCC main
# 2026-11-17 (bounded reviewer verdict finalization and ambiguity controls). A contract
# field does not rewrite an already-published image: pass its resolved
# source pin explicitly when building a matching worker:
#   podman build --build-arg SCC_ENGINE_PIN=<resolved engine.pin> ...
# (`make containers SCC_ENGINE_PIN=<pin>` — see runtime/k8s/README.md).
# init+fetch+checkout instead of `git clone --branch`: a bare SHA is a
# valid fetch target but not a clone-able branch/tag name.
ARG SCC_ENGINE_PIN=b1a8d98cd0288a0b401ea73db509a9759fa9e645
# Fail closed on anything but an immutable ref — the same check
# this image build enforces. A mutable ref
# (main, HEAD, …) would bake whatever lands upstream next into a
# published image built beside registry credentials.
RUN printf '%s' "$SCC_ENGINE_PIN" | grep -Eqx '[0-9a-f]{40}|v?[0-9]+\.[0-9]+\.[0-9]+([-.][0-9A-Za-z.-]+)?' \
    || { echo "SCC_ENGINE_PIN '$SCC_ENGINE_PIN' is not an immutable ref — expected a 40-char commit SHA or semver tag (feed it the resolved contract engine.pin)" >&2; exit 1; }
RUN git init -q /opt/scc \
    && git -C /opt/scc remote add origin https://github.com/os-santiago/sc-agent-cli \
    && git -C /opt/scc fetch -q --depth 1 origin "$SCC_ENGINE_PIN" \
    && git -C /opt/scc checkout -q --detach FETCH_HEAD \
    && cd /opt/scc && npm ci && npm run build && npm prune --omit=dev

# node:alpine (not distroless): running `scc` needs a Node runtime, and
# the base image's apk gives us a non-root `node` user plus `git`
# (internal/checkout's dependency) without hand-rolling either. OpenShift's
# restricted SCC still applies cleanly: no root-owned writes are needed
# anywhere this image reads from, and the pod sets runAsNonRoot/
# allowPrivilegeEscalation:false/capabilities:drop:[ALL] exactly like the
# distroless components (see deploy/kustomize/base/README.md "Security
# posture"). HOME and TMPDIR are both set under /workspaces (the same
# emptyDir volume AI_SDLC_WORKSPACE_DIR lives on) so SCCConfig's
# $HOME/.sc-agent/config.json write, npm/node's own cache writes, and
# SCCEngine.Invoke's os.MkdirTemp("", "ai-sdlc-attempt-*") call (which
# defaults to /tmp — part of the read-only root filesystem, confirmed by
# running a real dispatch against this image and hitting "mkdir
# /tmp/ai-sdlc-attempt-...: read-only file system") all have somewhere
# to go despite readOnlyRootFilesystem: true — no extra volume needed.
FROM docker.io/library/node:22-alpine
RUN apk add --no-cache git
COPY --from=sccbuild /opt/scc /opt/scc
# Replaces sc-agent-cli's own bin/scc wrapper (`import '../dist/cli.js'`,
# a relative import that would need to resolve correctly through
# whatever /usr/local/bin/scc ends up being — a symlink or not) with an
# equivalent wrapper using an absolute path, so where this file lives on
# PATH never matters.
RUN printf '#!/usr/bin/env node\nimport "/opt/scc/dist/cli.js";\n' > /usr/local/bin/scc \
    && chmod +x /usr/local/bin/scc
COPY --from=build /out/component /component
COPY --from=build /out/executor /executor
RUN mkdir -p /opt/ai-sdlc/empty-git-template && chmod 0555 /opt/ai-sdlc/empty-git-template
ENV HOME=/workspaces/home
ENV TMPDIR=/workspaces/tmp
USER 1000:1000
EXPOSE 8080
ENTRYPOINT ["/component"]

# The same reviewed image supplies a trusted completion-only sidecar. Executor
# Pods mount no model credentials and retain their offline gVisor boundary.
USER 0
RUN apk add --no-cache python3 curl \
    && curl --fail --location --proto '=https' --proto-redir '=https' --connect-timeout 15 --max-time 180 \
       https://github.com/openai/codex/releases/download/rust-v0.169.0/codex-x86_64-unknown-linux-musl.tar.gz -o /tmp/codex.tar.gz \
    && echo '9af4d751fce183faedea629437d5252dbf458eeb04130cf4f97be844621ea985  /tmp/codex.tar.gz' | sha256sum -c - \
    && tar -xzf /tmp/codex.tar.gz -C /usr/local/bin codex-x86_64-unknown-linux-musl \
    && mv /usr/local/bin/codex-x86_64-unknown-linux-musl /usr/local/bin/codex \
    && chmod 0555 /usr/local/bin/codex && rm /tmp/codex.tar.gz
COPY tools/codex_completion_process.py tools/codex_completion_child.py tools/codex_completion_policy.py tools/codex_completion_catalog.json tools/codex_completion_instructions.txt tools/codexcli_openai_wrapper.py tools/codex_gateway.py tools/model_adapters.py tools/model_benchmark.py tools/model_gateway.py /opt/ai-sdlc/model/
USER 1000:1000
