FROM docker.io/library/golang@sha256:5f1b98fa02fe396ebce2a0227a0e08309e11792915b9dd2e1f71053d7e7e6666 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY internal ./internal
COPY components/deployer ./components/deployer
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/component ./components/deployer/cmd

FROM gcr.io/distroless/static-debian12@sha256:d75cdd72874d4790092fcb1b058493ecf6bb5bf2b2b897045b00ff01d91843f2
COPY --from=build /out/component /component
USER 1000:1000
ENTRYPOINT ["/component"]
