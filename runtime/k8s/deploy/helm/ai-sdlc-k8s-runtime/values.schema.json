{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "fullnameOverride": {
      "type": "string"
    },
    "nameOverride": {
      "type": "string"
    },
    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "create",
        "name"
      ]
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string"
        }
      },
      "required": [
        "repository",
        "tag",
        "pullPolicy"
      ]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "readinessTimeoutSeconds": {
          "description": "Readiness probe timeoutSeconds of every runtime component; 0 omits it (kubelet default).",
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        }
      }
    },
    "metrics": {
      "description": "Prometheus metrics on a separate listener; off by default (renders nothing).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "port": {
          "description": "Metrics listener port of every runtime component.",
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "scrapeFrom": {
          "description": "NetworkPolicy peers admitted to the metrics port; required when enabled.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "namespaceSelector": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "matchLabels": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "matchExpressions": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  }
                }
              },
              "podSelector": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "matchLabels": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "matchExpressions": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  }
                }
              },
              "ipBlock": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "cidr"
                ],
                "properties": {
                  "cidr": {
                    "type": "string"
                  },
                  "except": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "podMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(s|m)$"
            }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "create",
        "name"
      ]
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "maintenance",
            "shadow",
            "candidate",
            "verification"
          ]
        },
        "paused": {
          "type": "boolean",
          "default": false
        },
        "intakePaused": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "mode"
      ]
    },
    "logLevel": {
      "type": "string"
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inline": {
          "type": "string"
        }
      },
      "required": [
        "inline"
      ]
    },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "local": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "image": {
              "type": "string"
            },
            "storageSize": {
              "type": "string"
            },
            "storageClass": {
              "type": "string"
            }
          },
          "required": [
            "enabled",
            "image",
            "storageSize",
            "storageClass"
          ]
        },
        "cloudNativePG": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "clusterName": {
              "type": "string"
            },
            "instances": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "storageSize": {
              "type": "string"
            }
          },
          "required": [
            "enabled",
            "clusterName",
            "instances",
            "storageSize"
          ]
        },
        "databaseURLSecret": {
          "description": "Existing Secret whose key holds the bootstrap owner's postgresql:// URL for the migrator (the bundled PostgreSQL also reads its password key). Ignored when CloudNativePG is enabled: its generated <clusterName>-app Secret is used. See docs/operations/helm-chart-secret-contract.md.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "key"
          ]
        }
      },
      "required": [
        "local",
        "cloudNativePG",
        "databaseURLSecret"
      ]
    },
    "backup": {
      "description": "Scheduled pg_dump of the runtime database to a volume; off by default (renders nothing). See docs/operations/backup-and-restore.md.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "schedule": {
          "description": "Cron schedule of the backup, five fields.",
          "type": "string",
          "pattern": "^\\S+( \\S+){4}$"
        },
        "timeZone": {
          "description": "IANA time zone of the schedule; empty uses the controller's.",
          "type": "string"
        },
        "retention": {
          "description": "Complete backups kept on the volume.",
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "image": {
          "description": "pg_dump image pinned by digest; empty uses postgres.local.image.",
          "type": "string",
          "pattern": "^$|^[^\\s@]+@sha256:[0-9a-f]{64}$"
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingClaim": {
              "description": "Existing PersistentVolumeClaim; empty creates <fullname>-backup.",
              "type": "string"
            },
            "size": {
              "type": "string",
              "minLength": 1
            },
            "storageClass": {
              "type": "string"
            }
          },
          "required": [
            "existingClaim",
            "size",
            "storageClass"
          ]
        },
        "startingDeadlineSeconds": {
          "type": "integer",
          "minimum": 10
        },
        "backoffLimit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 60
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                }
              },
              "required": [
                "cpu",
                "memory"
              ]
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cpu": {
                  "type": "string"
                },
                "memory": {
                  "type": "string"
                }
              },
              "required": [
                "cpu",
                "memory"
              ]
            }
          },
          "required": [
            "requests",
            "limits"
          ]
        }
      },
      "required": [
        "enabled",
        "schedule",
        "timeZone",
        "retention",
        "image",
        "storage",
        "startingDeadlineSeconds",
        "backoffLimit",
        "activeDeadlineSeconds",
        "resources"
      ]
    },
    "engine": {
      "type": "string"
    },
    "modelProvider": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseURL": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "workspaceDir": {
          "type": "string"
        },
        "apiKeySecret": {
          "description": "Not mounted by any workload. The provenance template only refuses to reuse this name for its registry credential. Model credentials use modelGateway.upstream.credentialSecret or the ai-sdlc-codex-auth Secret.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "key": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "key"
          ]
        }
      },
      "required": [
        "baseURL",
        "model",
        "workspaceDir",
        "apiKeySecret"
      ]
    },
    "components": {
      "type": "object",
