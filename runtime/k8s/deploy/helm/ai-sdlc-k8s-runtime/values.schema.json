    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "databaseEgressCIDRs": {
          "type": "array"
        }
      },
      "required": [
        "enabled",
        "databaseEgressCIDRs"
      ]
    },
    "openshift": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "route": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "host": {
              "type": "string"
            }
          },
          "required": [
            "enabled",
            "host"
          ]
        }
      },
      "required": [
        "route"
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyConfigMap",
        "identitySecretPrefix",
        "databaseSecretPrefix",
        "policyJSON",
        "installationUID"
      ],
      "properties": {
        "policyConfigMap": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,51}$"
        },
        "identitySecretPrefix": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,51}$"
        },
        "databaseSecretPrefix": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,51}$"
        },
        "policyJSON": {
          "type": "string",
          "maxLength": 131072
        },
        "installationUID": {
          "type": "string"
        }
      }
    },
    "migrator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "credentialsSecret"
      ],
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^(|sha256:[a-f0-9]{64})$"
        },
        "credentialsSecret": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "intake": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configJSON",
        "credentialSecret"
      ],
      "properties": {
        "configJSON": {
          "type": "string"
        },
        "credentialSecret": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configJSON",
        "apiServerCIDRs"
      ],
      "properties": {
        "configJSON": {
          "type": "string",
          "maxLength": 131072
        },
        "apiServerCIDRs": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/32$"
          }
        },
        "credentialRevision": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9]*$"
        }
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest"
      ],
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "configJSON"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "configJSON": {
          "type": "string",
          "maxLength": 131072
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "credentialRevision"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "credentialRevision": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9]*$"
        }
      }
    },
    "merge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "configJSON": {
          "type": "string",
          "maxLength": 16384
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "configJSON": {
          "type": "string",
          "maxLength": 131072
        },
        "outerPolicyJSON": {
          "type": "string",
          "maxLength": 131072
        }
      },
      "required": [
        "enabled",
        "digest",
        "configJSON",
        "outerPolicyJSON"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "trustJSON",
        "registryCredentialSecret",
        "credentialRevision"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "trustJSON": {
          "type": "string",
          "maxLength": 131072
        },
        "registryCredentialSecret": {
          "type": "string",
          "maxLength": 63,
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "credentialRevision": {
          "type": "string",
          "pattern": "^$|^[a-f0-9]{64}$"
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "digest",
        "targetJSON"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "targetJSON": {
          "type": "string",
          "maxLength": 98304
        },
        "browserProfileJSON": {
          "type": "string"
        }
      }
    },
    "modelGateway": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "upstream",
        "benchmark"
      ],
      "properties": {
        "adapter": {
          "enum": [
            "agent-cli",
            "openai",
            "anthropic"
          ]
        },
        "upstream": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "model",
            "cidr",
            "port",
            "seconds",
            "credentialSecret",
            "directAnswers"
          ],
          "properties": {
            "url": {
              "type": "string",
              "maxLength": 512
            },
            "model": {
              "type": "string",
              "maxLength": 128
            },
            "cidr": {
              "type": "string",
              "maxLength": 64
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "seconds": {
              "type": "integer",
              "minimum": 30,
              "maximum": 570
            },
            "credentialSecret": {
              "type": "string",
              "maxLength": 253,
              "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$"
            },
            "directAnswers": {
              "type": "boolean"
            }
          }
        },
        "benchmark": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "promptTokens",
            "completionTokens"
          ],
          "properties": {
            "promptTokens": {
              "type": "integer",
              "minimum": 256,
              "maximum": 262144
            },
            "completionTokens": {
              "type": "integer",
              "minimum": 64,
              "maximum": 32768
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "adapter": {
                "const": "anthropic"
              }
            }
          },
          "then": {
            "properties": {
              "upstream": {
                "properties": {
                  "credentialSecret": {
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "fullnameOverride",
    "nameOverride",
    "namespace",
    "image",
    "imagePullSecrets",
    "serviceAccount",
    "runtime",
    "logLevel",
    "contract",
    "postgres",
    "engine",
    "modelProvider",
    "components",
    "networkPolicy",
    "openshift",
    "authority",
    "migrator",
    "intake"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#"
}
