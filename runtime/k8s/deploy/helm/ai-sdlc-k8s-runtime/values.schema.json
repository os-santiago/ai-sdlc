    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "databaseEgressCIDRs": {
          "type": "array"
        }
      },
      "required": [
        "enabled",
        "databaseEgressCIDRs"
      ]
    },
    "openshift": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "route": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "host": {
              "type": "string"
            }
          },
          "required": [
            "enabled",
            "host"
          ]
        }
      },
      "required": [
        "route"
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyConfigMap",
        "identitySecretPrefix",
        "databaseSecretPrefix",
        "policyJSON",
        "installationUID"
      ],
      "properties": {
        "policyConfigMap": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,51}$"
        },
        "identitySecretPrefix": {
          "description": "Prefix of the per-component signing identity Secrets <prefix>-<role> (keys identity.json, public-key.json), generated once and adopted. See docs/operations/helm-chart-secret-contract.md.",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,51}$"
        },
        "databaseSecretPrefix": {
          "description": "Prefix of the per-component database Secrets <prefix>-<role> (key uri), generated once and adopted. See docs/operations/helm-chart-secret-contract.md.",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,51}$"
        },
        "policyJSON": {
          "type": "string",
          "maxLength": 131072
        },
        "installationUID": {
          "type": "string"
        }
      }
    },
    "migrator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "credentialsSecret"
      ],
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^(|sha256:[a-f0-9]{64})$"
        },
        "credentialsSecret": {
          "description": "Secret with key passwords.json mapping each component role to its database password; the migrator creates the roles from it. See docs/operations/helm-chart-secret-contract.md.",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "intake": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configJSON",
        "credentialSecret"
      ],
      "properties": {
        "configJSON": {
          "type": "string"
        },
        "credentialSecret": {
          "description": "Supplied Secret with key credential.json (the GitHub client) that intake reads in shadow, candidate and verification modes. See docs/operations/helm-chart-secret-contract.md.",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configJSON",
        "apiServerCIDRs"
      ],
      "properties": {
        "configJSON": {
          "type": "string",
          "maxLength": 131072
        },
        "apiServerCIDRs": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/32$"
          }
        },
        "credentialRevision": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9]*$"
        }
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtimeClassName"
      ],
      "properties": {
        "runtimeClassName": {
          "description": "Kubernetes RuntimeClass (DNS-1123 subdomain) every executor, reviewer and verification pod runs in.",
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
        },
        "podOverhead": {
          "description": "Per-pod quota headroom for the class's overhead.podFixed: whole millicores and Mi.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {"type": "string", "pattern": "^$|^[0-9]{1,6}m$"},
            "memory": {"type": "string", "pattern": "^$|^[0-9]{1,6}Mi$"}
          }
        }
      }
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest"
      ],
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "sourceCredential": {
          "description": "Mount the ai-sdlc-source-reader Secret (repository-scoped read credential) into the verifier container only.",
          "type": "boolean"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "configJSON"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "configJSON": {
          "type": "string",
          "maxLength": 131072
        },
        "narrowModelTools": {
          "type": "boolean"
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "credentialRevision"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "credentialRevision": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9]*$"
        }
      }
    },
    "merge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "configJSON": {
          "type": "string",
          "maxLength": 16384
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "configJSON": {
          "type": "string",
          "maxLength": 131072
        },
        "outerPolicyJSON": {
          "type": "string",
          "maxLength": 131072
        }
      },
      "required": [
        "enabled",
        "digest",
        "configJSON",
        "outerPolicyJSON"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "trustJSON",
        "registryCredentialSecret",
        "credentialRevision"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "trustJSON": {
          "type": "string",
          "maxLength": 131072
        },
        "registryCredentialSecret": {
          "description": "Supplied Secret with key credential.json for the provenance verifier's pull-only registry identity; must be named <release fullname>-provenance-registry. See docs/operations/helm-chart-secret-contract.md.",
          "type": "string",
          "maxLength": 63,
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "credentialRevision": {
          "type": "string",
          "pattern": "^$|^[a-f0-9]{64}$"
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "digest",
        "targetJSON"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "targetJSON": {
          "type": "string",
          "maxLength": 98304
        },
        "browserProfileJSON": {
          "type": "string"
        }
      }
    },
    "modelGateway": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "upstream",
        "benchmark",
        "reviewBenchmark"
      ],
      "properties": {
        "adapter": {
          "enum": [
            "agent-cli",
            "openai",
            "anthropic"
          ]
        },
        "upstream": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "model",
            "cidr",
            "port",
            "seconds",
            "credentialSecret",
            "directAnswers"
          ],
          "properties": {
            "url": {
              "type": "string",
              "maxLength": 512
            },
            "model": {
              "type": "string",
              "maxLength": 128
            },
            "cidr": {
              "type": "string",
              "maxLength": 64
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "seconds": {
              "type": "integer",
              "minimum": 30,
              "maximum": 570
            },
            "credentialSecret": {
              "description": "Optional supplied Secret with key credential (the upstream API key) mounted into the worker and verifier model gateways. See docs/operations/helm-chart-secret-contract.md.",
              "type": "string",
              "maxLength": 253,
              "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$"
            },
            "directAnswers": {
              "type": "boolean"
            }
          }
        },
        "benchmark": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "promptTokens",
            "completionTokens"
          ],
          "properties": {
            "promptTokens": {
              "type": "integer",
              "minimum": 256,
              "maximum": 262144
            },
            "completionTokens": {
              "type": "integer",
              "minimum": 64,
              "maximum": 32768
            }
          }
        },
        "reviewBenchmark": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "promptTokens",
            "completionTokens"
          ],
          "properties": {
            "promptTokens": {
              "type": "integer",
              "minimum": 256,
              "maximum": 262144
            },
            "completionTokens": {
              "type": "integer",
              "minimum": 64,
              "maximum": 32768
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "adapter": {
                "const": "anthropic"
              }
            }
          },
          "then": {
            "properties": {
              "upstream": {
                "properties": {
                  "credentialSecret": {
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifestJSON"
      ],
      "properties": {
        "manifestJSON": {
          "type": "string",
          "maxLength": 16384
        },
        "verifierQuota": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests.cpu": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,5}m?$"
            },
            "requests.memory": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,5}(Mi|Gi)$"
            },
            "limits.cpu": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,5}m?$"
            },
            "limits.memory": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,5}(Mi|Gi)$"
            }
          },
          "anyOf": [
            {
              "maxProperties": 0
            },
            {
              "required": [
                "requests.cpu",
                "requests.memory",
                "limits.cpu",
                "limits.memory"
              ]
            }
          ]
        }
      }
    }
  },
  "required": [
    "fullnameOverride",
    "nameOverride",
    "namespace",
    "image",
    "imagePullSecrets",
    "serviceAccount",
    "runtime",
    "logLevel",
    "contract",
    "postgres",
    "engine",
    "modelProvider",
    "components",
    "networkPolicy",
    "openshift",
    "authority",
    "migrator",
    "intake"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#"
}
