{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI-SDLC local installation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "cluster", "provider", "repository", "environment", "profile", "images"],
  "properties": {
    "apiVersion": {"const": "ai-sdlc.io/local-install/v1"},
    "kind": {"const": "LocalInstallation"},
    "cluster": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,35}$"},
    "provider": {"enum": ["auto", "docker", "podman"]},
    "repository": {"type": "string", "pattern": "^(?!\\.{1,2}/)(?![^/]+/\\.{1,2}$)[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "environment": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
    "profile": {"enum": ["maintenance", "shadow"]},
    "images": {"type": "string", "minLength": 1, "pattern": "^[^\\u0000]+$", "description": "Pinned image lock path, relative to this configuration file or absolute."}
  }
}
