{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI-SDLC local installation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "cluster",
    "provider",
    "repository",
    "environment",
    "profile",
    "images"
  ],
  "properties": {
    "apiVersion": {
      "const": "ai-sdlc.io/local-install/v1"
    },
    "kind": {
      "const": "LocalInstallation"
    },
    "cluster": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,35}$"
    },
    "provider": {
      "enum": [
        "auto",
        "docker",
        "podman"
      ]
    },
    "repository": {
      "type": "string",
      "pattern": "^(?!\\.{1,2}/)(?![^/]+/\\.{1,2}$)[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "environment": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "profile": {
      "enum": [
        "maintenance",
        "shadow",
        "candidate",
        "verification"
      ]
    },
    "images": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$",
      "description": "Pinned image lock path, relative to this configuration file or absolute."
    },
    "independentReview": {
      "type": "boolean",
      "description": "Explicit read-only independent review; requires verification profile."
    },
    "publication": {
      "type": "boolean",
      "description": "Explicit signed verified PR publication; requires a reviewed repository, verification and independent review."
    },
    "merge": {
      "type": "boolean",
      "description": "Explicit low-risk authenticated merge; requires verified publication and native strict protection."
    },
    "platform": {
      "enum": [
        "kind",
        "konflux",
        "openshift"
      ],
      "description": "kind creates an owned runtime cluster; konflux uses an existing owned supply-chain cluster with frozen default or explicitly approved build capability; openshift installs into an existing owned cluster selected by kubeconfig and context."
    },
    "namespace": {
      "const": "ai-sdlc-runtime",
      "description": "Optional assertion of the fixed runtime namespace; the installer supports ai-sdlc-runtime only."
    },
    "kubeconfig": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$",
      "description": "Existing OpenShift kubeconfig path, relative to this configuration file or absolute; requires the openshift platform."
    },
    "context": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@-]{0,127}$",
      "description": "Context of the declared kubeconfig to install into; requires the openshift platform."
    },
    "timeout": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,3}(s|m)$",
      "description": "Bounded positive seconds or minutes applied to each wait operation; defaults to 10m."
    },
    "projectManifest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$",
      "description": "Reviewed ai-sdlc.project/v1 manifest path, relative to this configuration file or absolute; requires the verification profile and a non-reference repository."
    },
    "modelUpstream": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$",
      "description": "Reviewed OpenAI-compatible model service document path, relative to this configuration file or absolute; requires the candidate or verification profile."
    },
    "buildBundle": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$",
      "description": "Reviewed public build desired state path; requires the Konflux Saferus verification/review/publication/merge scope."
    },
    "reviewRepair": {
      "type": "boolean",
      "description": "Allow at most one repair from original unused generation capacity; disabled by default."
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "independentReview"
        ]
      },
      "then": {
        "properties": {
          "profile": {
            "const": "verification"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "publication"
        ],
        "properties": {
          "publication": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "independentReview"
        ],
        "properties": {
          "independentReview": {
            "const": true
          },
          "profile": {
            "const": "verification"
          }
        },
        "anyOf": [
          {
            "properties": {
              "repository": {
                "enum": [
                  "os-santiago/homedir",
                  "os-santiago/saferus"
                ]
              }
            }
          },
          {
            "required": [
              "projectManifest"
            ]
          }
        ]
      }
    },
    {
      "if": {
        "required": [
          "merge"
        ],
        "properties": {
          "merge": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "publication"
        ],
        "properties": {
          "publication": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "platform"
        ],
        "properties": {
          "platform": {
            "const": "konflux"
          }
        },
        "not": {
          "required": [
            "buildBundle"
          ]
        }
      },
      "then": {
        "properties": {
          "profile": {
            "const": "maintenance"
          },
          "repository": {
            "const": "os-santiago/saferus"
          },
          "environment": {
            "const": "ai-sdlc-production"
          },
          "publication": {
            "const": false
          },
          "merge": {
            "const": false
          }
        },
        "not": {
          "required": [
            "independentReview"
          ]
        }
      }
    },
    {
      "if": {
        "required": [
          "buildBundle"
        ]
      },
      "then": {
        "required": [
          "platform",
          "merge",
          "publication",
          "independentReview"
        ],
        "properties": {
          "platform": {
            "const": "konflux"
          },
          "profile": {
            "const": "verification"
          },
          "repository": {
            "const": "os-santiago/saferus"
          },
          "environment": {
            "const": "ai-sdlc-production"
          },
          "merge": {
            "const": true
          },
          "publication": {
            "const": true
          },
          "independentReview": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "projectManifest"
        ]
      },
      "then": {
        "properties": {
          "profile": {
            "const": "verification"
          },
          "repository": {
            "not": {
              "enum": [
                "os-santiago/homedir",
                "os-santiago/saferus"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "platform"
        ],
        "properties": {
          "platform": {
            "const": "openshift"
          }
        }
      },
      "then": {
        "required": [
          "kubeconfig",
          "context"
        ]
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "required": [
              "kubeconfig"
            ]
          },
          {
            "required": [
              "context"
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "platform": {
            "const": "openshift"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "modelUpstream"
        ]
      },
      "then": {
        "properties": {
          "profile": {
            "enum": [
              "candidate",
              "verification"
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "reviewRepair"
        ],
        "properties": {
          "reviewRepair": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "independentReview"
        ],
        "properties": {
          "independentReview": {
            "const": true
          },
          "profile": {
            "const": "verification"
          }
        }
      }
    }
  ]
}
